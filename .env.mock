# Modo mockado (npm run dev:mock): app roda 100% offline com dados fictícios.
# Todas as chamadas HTTP são interceptadas pelo adapter mock em src/mocks/.
VITE_USE_MOCKS=true
VITE_API_BASE_URL=/api

VITE_APP_NAME=Glow Up Connect
VITE_TOKEN_HEADER=x-glow-token
# Em modo mock não há integração com Mercado Pago / reCAPTCHA / WhatsApp.
VITE_MP_PUBLIC_KEY=
VITE_CAPTCHA_SITE_KEY=
VITE_WHATSAPP_NUMBER=

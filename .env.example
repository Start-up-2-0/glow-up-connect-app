# Staging/prod (Railway): OBRIGATÓRIO same-origin — NÃO use URL completa da API.
VITE_API_BASE_URL=/api
# Dev local: proxy Vite encaminha /api para a API (ajuste se a porta local mudar)
VITE_API_PROXY_TARGET=https://api-staging-61ce.up.railway.app
VITE_APP_NAME=Glow Up Connect
VITE_TOKEN_HEADER=x-glow-token
VITE_MP_PUBLIC_KEY=
VITE_WHATSAPP_NUMBER=
# reCAPTCHA v2 Checkbox (obrigatorio em staging/prod) — par Site key do Google
VITE_CAPTCHA_SITE_KEY=
VITE_LANDING_URL=https://glowupconnect.com.br

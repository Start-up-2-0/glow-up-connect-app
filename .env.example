# Dev: use /api para proxy Vite → http://localhost:5127
# Prod/staging (Railway): URL pública da API (ex.: https://glow-up-connect-api.up.railway.app)
# Variáveis VITE_* são embutidas no build — alterar exige redeploy
VITE_API_BASE_URL=/api

VITE_APP_NAME=Glow Up Connect

# Header de autenticação (deve coincidir com Auth:TokenHeaderName da API)
VITE_TOKEN_HEADER=x-glow-token

# Backend: Auth:FrontendBaseUrl = raiz do app (ex.: http://localhost:5173)
# O link no e-mail sera {FrontendBaseUrl}/confirmar-email?token=... (redirect no SPA para /auth/confirmar-email)

# Mercado Pago — chave publica para tokenizacao de cartao no checkout
VITE_MP_PUBLIC_KEY=

# WhatsApp — numero com DDI para botao flutuante na landing (ex.: 5511999999999)
VITE_WHATSAPP_NUMBER=
